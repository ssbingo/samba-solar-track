(version 1)
# Regeln der Platine HallTapBoard fuer die Fertigung bei JLCPCB (2 Lagen, 1,6 mm, 1 oz), mit Reserve.
# Erzeugt von tools/halltap_erzeugen.py; Aenderungen dort vornehmen.
# KiCad nimmt je Pruefart die LETZTE passende Regel: allgemeine Regeln zuerst, besondere danach.

(rule "Leiterbahn mindestens 0,2 mm"
	(condition "A.Type == 'Track'")
	(constraint track_width (min 0.2mm)))

(rule "Abstand verschiedener Netze 0,2 mm"
	(condition "A.Net != B.Net")
	(constraint clearance (min 0.2mm)))

(rule "24 V 0,3 mm"
	(condition "A.hasNetclass('V24') && A.Net != B.Net")
	(constraint clearance (min 0.3mm)))

(rule "Kupfer zum Rand 0,5 mm"
	(constraint edge_clearance (min 0.5mm)))

(rule "Druck zu Pad 0,15 mm"
	(condition "B.Type == 'Pad'")
	(constraint silk_clearance (min 0.15mm)))

(rule "Bohrung zu fremdem Kupfer 0,3 mm"
	(condition "A.Net != B.Net")
	(constraint hole_clearance (min 0.3mm)))

(rule "Bohrung zu Bohrung 0,5 mm"
	(constraint hole_to_hole (min 0.5mm)))

(rule "Via 0,6/0,3 mm"
	(condition "A.Type == 'Via'")
	(constraint hole_size (min 0.3mm)))

(rule "Via zu fremdem Pad 0,35 mm"
	(layer outer)
	(condition "A.Type == 'Via' && B.Type == 'Pad' && A.Net != B.Net")
	(constraint clearance (min 0.35mm)))

# Trennung zwischen Eingangsseite (Masse der SCN4, 24 V der Antriebe) und Ausgangsseite (potentialfrei, Masse der
# RearCircuitBoard_10): Funktionsisolation, Begruendung in der README. Steht am Ende, damit sie vorgeht.
(rule "Trennstrecke Eingang zu Ausgang 6.0 mm"
	(condition "A.hasNetclass('AUSGANG') && !B.hasNetclass('AUSGANG') && B.NetName != ''")
	(constraint clearance (min 6.0mm)))

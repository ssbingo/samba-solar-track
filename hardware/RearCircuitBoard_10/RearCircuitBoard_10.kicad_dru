(version 1)
# Regeln der Platine RearCircuitBoard_10 fuer die Fertigung bei JLCPCB (4 Lagen JLC04161H-7628,
# aussen 1 oz, innen 0,5 oz). Werte aus https://jlcpcb.com/capabilities/pcb-capabilities und
# https://jlcpcb.com/help/article/pcb-via-covering (abgerufen 3.10.2026), mit Reserve.
# Erzeugt von tools/platine_layout.py; Aenderungen dort vornehmen.
# KiCad nimmt je Pruefart die LETZTE passende Regel: allgemeine Regeln zuerst, besondere danach.

(rule "Leiterbahn mindestens 0,15 mm"
	(condition "A.Type == 'Track'")
	(constraint track_width (min 0.15mm)))

(rule "Abstand verschiedener Netze 0,2 mm"
	(condition "A.Net != B.Net")
	(constraint clearance (min 0.2mm)))

# Eigene Regeln ersetzen den Abstand der Netzklassen; groessere Abstaende deshalb hier wiederholen.
(rule "24 V, Schaltknoten und RS485-Bus 0,3 mm"
	(condition "(A.hasNetclass('V24') || A.hasNetclass('SW') || A.hasNetclass('RS485')) && A.Net != B.Net")
	(constraint clearance (min 0.3mm)))

# Bauteilregeln (Spalt Pad-Pad nach TI-Landmuster; Entwurf 0.9, Befund M-1)
(rule "U7 Pad zu Pad 0,2 mm (TI RGY0020B)"
	(condition "A.Type == 'Pad' && B.Type == 'Pad' && A.memberOfFootprint('U7') && B.memberOfFootprint('U7')")
	(constraint clearance (min 0.2mm)))
(rule "U7 Bahnen am Gehaeuse 0,2 mm (Pinraster 0,5 mm)"
	(condition "A.intersectsCourtyard('U7') && B.intersectsCourtyard('U7')")
	(constraint clearance (min 0.2mm)))
(rule "U15 Pad zu Pad 0,2 mm (TI RPW0010A)"
	(condition "A.Type == 'Pad' && B.Type == 'Pad' && A.memberOfFootprint('U15') && B.memberOfFootprint('U15')")
	(constraint clearance (min 0.2mm)))
(rule "U16 Pad zu Pad 0,2 mm (TI PWP0016A)"
	(condition "A.Type == 'Pad' && B.Type == 'Pad' && A.memberOfFootprint('U16') && B.memberOfFootprint('U16')")
	(constraint clearance (min 0.2mm)))
(rule "U17 Pad zu Pad 0,15 mm (SOT-563, JLCPCB ab 0,1 mm)"
	(condition "A.Type == 'Pad' && B.Type == 'Pad' && A.memberOfFootprint('U17') && B.memberOfFootprint('U17')")
	(constraint clearance (min 0.15mm)))

(rule "Kontaktbereich nur fuer Kontakte"
	(condition "A.intersectsArea('SF-Kontakt') && (A.Type == 'Track' || A.Type == 'Via') && !A.hasNetclass('KONTAKT')")
	(constraint disallow track via))

(rule "Kupfer zum Rand 0,5 mm"
	(constraint edge_clearance (min 0.5mm)))

# JLCPCB: Bestueckungsdruck mindestens 0,15 mm von Pads
(rule "Druck zu Pad 0,15 mm"
	(condition "B.Type == 'Pad'")
	(constraint silk_clearance (min 0.15mm)))

(rule "Bohrung zu fremdem Kupfer 0,3 mm"
	(condition "A.Net != B.Net")
	(constraint hole_clearance (min 0.3mm)))

(rule "Bohrung zu Bohrung 0,5 mm"
	(constraint hole_to_hole (min 0.5mm)))

# Ohne Aufpreis ab 0,3 mm; verschliessbar bis 0,5 mm
(rule "Via-Bohrung 0,3 bis 0,5 mm"
	(condition "A.Type == 'Via'")
	(constraint hole_size (min 0.3mm) (max 0.5mm)))

(rule "Via-Durchmesser mindestens 0,6 mm"
	(condition "A.Type == 'Via'")
	(constraint via_diameter (min 0.6mm)))

# Vias naeher als 0,35 mm an einem Pad lassen sich nicht verschliessen
(rule "Via zu fremdem Pad 0,35 mm"
	(layer outer)
	(condition "A.Type == 'Via' && B.Type == 'Pad' && A.Net != B.Net")
	(constraint clearance (min 0.35mm)))

# Vias auch nicht dicht an Pads des eigenen Netzes (Lot im Via, nicht verschliessbar)
(rule "Via zu Pad 0,35 mm"
	(layer outer)
	(condition "A.Type == 'Via' && B.Type == 'Pad'")
	(constraint physical_clearance (min 0.35mm)))

# Ausnahme: Vias im Drain-Pad von Q2 nach dem TI-Landmuster (SLPS633 7.2), gefuellt und verschlossen (E21), nur gegen
# die Drain-Pads (Pad 5, eigenes Netz VIN_BUCK); zu Source und Gate gilt weiter 0,35 mm
(rule "Vias im Drain-Pad von Q2"
	(layer outer)
	(condition "A.Type == 'Via' && B.Type == 'Pad' && B.memberOfFootprint('Q2') && B.Pad_Number == '5' && A.Net == B.Net")
	(constraint physical_clearance (min 0mm)))

# Potentialfreie Kontakte: bis 30 V fremde Spannung (D1-D4 SMAJ33CA leiten ab 33 V), Abstand zu allen
# anderen Netzen 1,0 mm; steht am Ende, damit sie auch fuer Vias gilt
(rule "Kontakte 1,0 mm"
	(condition "A.hasNetclass('KONTAKT') && A.Net != B.Net")
	(constraint clearance (min 1.0mm)))

# Ausnahme fuer die zweireihigen Kontaktklemmen J3-J6 (J3/J4 2 x 2, J5/J6 2 x 3): Nur zwei diagonal liegende
# Stifte tragen den Kontakt, die uebrigen sind frei (ohne Anschluss, schwebendes Metall ohne eigenes Potential).
# Bei 2,5 mm Reihenabstand und 1,9-mm-Pads liegt ein freier Stift 0,6 mm neben dem Kontaktpad derselben Spalte,
# in den Nachbarspalten mindestens 1,6 mm.
# Grundlage: hoechstens 30 V an den Kontakten. IPC-2221 (02/1998), Tabelle 6-1, S. 39, bis 30 V: B2 (aussen,
# ohne Lack, bis 3050 m) 0,1 mm, A6 (Anschluesse ohne Schutzlack, Abschnitt 6.3.4; in IPC-2221C heisst sie A7)
# 0,25 mm; 0,6 mm halten das mit Faktor 2,4 ein. IPC-2221A (2003) gleich, IPC-2221C (12/2023) bis 30 V gleich;
# Ausgabe B nicht eingesehen. Bedingung fuer Einbau und Betrieb (Entscheidung des Nutzers vom 6.10.2026, bei 30 V
# bleiben): Einbauort trocken, ohne Betauung, unter 3050 m. Quellen in der README.
# Gilt nur Pad gegen Pad derselben Klemme und nur, solange der freie Stift unbeschaltet ist (Netz
# unconnected-...); sonst wieder 1,0 mm.
# Leiterbahnen und alle anderen Teile halten 1,0 mm. Steht nach "Kontakte 1,0 mm", damit sie dort vorgeht.
(rule "Kontaktpad zu freiem Stift derselben Klemme 0,6 mm"
	(condition "A.Type == 'Pad' && B.Type == 'Pad' && A.hasNetclass('KONTAKT') && !B.hasNetclass('KONTAKT') && B.NetName == 'unconnected-*' && ((A.memberOfFootprint('J3') && B.memberOfFootprint('J3')) || (A.memberOfFootprint('J4') && B.memberOfFootprint('J4')) || (A.memberOfFootprint('J5') && B.memberOfFootprint('J5')) || (A.memberOfFootprint('J6') && B.memberOfFootprint('J6')))")
	(constraint clearance (min 0.6mm)))

# J1 ist ueber die durchgehenden Masselagen L2 und L3 an GND angeschlossen. Aussen laufen Bahnen
# zwischen den Stiften; Waermefallen haetten dort zu wenige Stege, deshalb aussen keine Flaechenanbindung.
(rule "J1 aussen ohne Flaechenanbindung"
	(layer outer)
	(condition "A.Type == 'Pad' && A.memberOfFootprint('J1')")
	(constraint zone_connection none))

# Restring fuer Bauteilbohrungen (Thermovias im Footprint von U7 ausgenommen)
(rule "Restring Bauteilbohrung 0,2 mm"
	(condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole' && A.Hole_Size_X >= 0.5mm")
	(constraint annular_width (min 0.2mm)))

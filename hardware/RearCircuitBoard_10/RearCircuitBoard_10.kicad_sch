  (text "5-V-Wandler LM5146 (U7) mit Q2/Q3" (exclude_from_sim no) (at 20.00 436.00 0) (effects (font (size 2.5 2.5) (bold yes)) (justify left bottom)) (uuid "58484cbc-825d-5c25-b51a-1e2625a836ce"))
  (text "U7 LM5146: 303 kHz (R51), Sanftanlauf 3,8 ms (C33), Start ab 13,2 V (R59/R60), Talstromgrenze 5,7-8,4 A (R52/R53), Hiccup nach 128 Takten.\nAusgang 0,8 V x (1 + R24/R25) = 5,05 V (R24/R25 0,1 %); in der Ladesperre R85 || R93 || R94 in Reihe zu R25: 3,98 V.\nEingang als Reihenpaare; Ausgang 4 x 47 uF + C22 Polymer (stabil auch ohne C22). R92/C38 nicht bestueckt." (exclude_from_sim no) (at 20.00 443.00 0) (effects (font (size 1.5 1.5)) (justify left bottom)) (uuid "d3ec008b-6b81-5e68-99b0-2481a812fbb5"))
